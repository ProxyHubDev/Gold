function Window:_UpdateMobileToggle()
	if self.MobileLabel then
		self.MobileLabel.Text = self.Visible and "OFF" or "ON"
	end
end

function Window:Show()
	if self.Visible then return end
	self.Visible = true
	local frame = self.Frame
	frame.Visible = true
	frame.Size = UDim2.new(0, self.Width, 0, self.Height)
	frame.BackgroundTransparency = 0.12
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Transparency = 0.94 end
	self:_UpdateMobileToggle()
end

function Window:Hide()
	if not self.Visible then return end
	self.Visible = false
	local frame = self.Frame
	frame.Visible = false
	frame.Size = UDim2.new(0, self.Width, 0, 0)
	frame.BackgroundTransparency = 1
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Transparency = 1 end
	self:_UpdateMobileToggle()
end

function Window:Toggle()
	if self.Visible then self:Hide() else self:Show() end
end

function Window:_RestackNotifications()
	local gap = 14
	local offset = 0
	for i = #self.Notifications, 1, -1 do
		local notif = self.Notifications[i]
		if not notif.Closing then
			local goalPos = UDim2.new(1, 0, 1, -offset)
			Tween(notif.Frame, {Position = goalPos}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			offset = offset + (notif.Height or 0) + gap
		end
	end
end

function Window:_CloseNotify(notif)
	if notif.Closing then return end
	notif.Closing = true
	if notif.Connection then
		notif.Connection:Disconnect()
		notif.Connection = nil
	end
	Tween(notif.Frame, {BackgroundTransparency = 1, Position = UDim2.new(1, 60, notif.Frame.Position.Y.Scale, notif.Frame.Position.Y.Offset)}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	Tween(notif.Stroke, {Transparency = 1}, 0.22)
	Tween(notif.Scale, {Scale = 0.82}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.3, function()
		for i, n in ipairs(self.Notifications) do
			if n == notif then table.remove(self.Notifications, i); break end
		end
		notif.Frame:Destroy()
		self:_RestackNotifications()
	end)
end

