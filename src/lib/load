	local function ClampWindowPosition()
		if not camera then return end
		local viewport = camera.ViewportSize
		local halfW = (windowWidth * uiScale.Scale) / 2
		local halfH = (windowHeight * uiScale.Scale) / 2

		local pos = main.Position
		local absX = pos.X.Scale * viewport.X + pos.X.Offset
		local absY = pos.Y.Scale * viewport.Y + pos.Y.Offset

		absX = math.clamp(absX, halfW, math.max(halfW, viewport.X - halfW))
		absY = math.clamp(absY, halfH, math.max(halfH, viewport.Y - halfH))

		main.Position = UDim2.new(0, absX, 0, absY)
	end

	win.ClampWindowPosition = ClampWindowPosition

	local function UpdateScale()
		uiScale.Scale = ComputeScale()
		ClampWindowPosition()
	end

