function Tab:_GetTarget(side)
	local target = self
	local compact = false

	if self.IsDual then
		if side == 1 then
			target = self.Left
		elseif side == 2 then
			target = self.Right
		else
			self._dualNext = self._dualNext or "Left"
			target = (self._dualNext == "Left") and self.Left or self.Right
			self._dualNext = (self._dualNext == "Left") and "Right" or "Left"
		end
		compact = true
	elseif self.Compact then
		compact = true
	end

	return target, compact
end

