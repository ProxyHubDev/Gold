		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, headerHeight),
		Parent = holder,
	}, {
		New("UIPadding", {
			PaddingLeft = UDim.new(0, compact and 12 or 18),
			PaddingRight = UDim.new(0, compact and 12 or 18),
			PaddingTop = UDim.new(0, compact and 8 or 12),
			PaddingBottom = UDim.new(0, compact and 8 or 12),
		}),
	})

	local rightGroup = New("Frame", {
		Name = "RightGroup",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0.5, -9),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 18),
		Parent = headerBtn,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local selectedLabel = New("TextLabel", {
		Name = "SelectedValue",
		BackgroundTransparency = 1,
		Text = placeholder,
		FontFace = DescFont,
		TextSize = compact and 12 or 13,
		TextColor3 = Colors.SubText,
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(0, compact and 82 or 104, 1, 0),
		LayoutOrder = 1,
		Parent = rightGroup,
	})

	local chevron = New("ImageLabel", {
		Name = "Chevron",
		BackgroundTransparency = 1,
		Image = "rbxassetid://10709790948",
		ImageColor3 = Colors.SubText,
		ImageTransparency = 0.2,
		Rotation = 0,
		Size = UDim2.new(0, 18, 0, 18),
		LayoutOrder = 2,
		Parent = rightGroup,
	})

	local titleLabel = New("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Text = title,
		FontFace = TitleFont,
		TextSize = compact and 13 or 16,
		TextColor3 = Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, compact and -112 or -132, description and 0 or 1, description and (compact and 16 or 20) or 0),
		Parent = headerBtn,
	})
	if lib then lib:Track(titleLabel, "Text", titleRaw) end

	if description then
		local descLabel = New("TextLabel", {
			Name = "Description",
			BackgroundTransparency = 1,
			Text = description,
			FontFace = DescFont,
			TextSize = compact and 11 or 14,
			TextColor3 = Colors.SubText,
			TextTransparency = 0.08,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, 0, 0, compact and 18 or 22),
			Size = UDim2.new(1, compact and -112 or -132, 0, compact and 26 or 32),
			Parent = headerBtn,
		})
		if lib then lib:Track(descLabel, "Text", descriptionRaw) end
	end

	local list = New("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, headerHeight),
		Size = UDim2.new(1, 0, 0, listHeight),
		Parent = holder,
	}, {
		New("UIListLayout", {Padding = UDim.new(0, itemGap), SortOrder = Enum.SortOrder.LayoutOrder}),
		New("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, listPadTop),
			PaddingBottom = UDim.new(0, listPadBottom),
		}),
	})

	local selected = multi and {} or nil
	if multi then
		if type(default) == "table" then
			for _, v in ipairs(default) do
				selected[v] = true
			end
		end
	else
		selected = default
	end

	local rows = {}

	local function GetSelectedText()
		local currentPlaceholder = lib and lib:Translate(placeholderRaw) or placeholderRaw
		if multi then
			local t = {}
			for _, opt in ipairs(items) do
				if selected[opt.Text] then table.insert(t, opt.Text) end
			end
			if #t == 0 then return currentPlaceholder end
			return table.concat(t, ", ")
		else
			return selected or currentPlaceholder
		end
	end

	local function HasSelection()
		if multi then
			for _, opt in ipairs(items) do
				if selected[opt.Text] then return true end
			end
			return false
		end
		return selected ~= nil
	end

	local function UpdateSelectedLabel()
		selectedLabel.Text = GetSelectedText()
		selectedLabel.TextColor3 = HasSelection() and Colors.Text or Colors.SubText
	end

	local function SaveFlag()
		if flag and lib then
			if multi then
				local t = {}
				for _, opt in ipairs(items) do
					if selected[opt.Text] then table.insert(t, opt.Text) end
				end
				lib.Flags[flag] = t
				lib:Save(flag, t)
			else
				lib.Flags[flag] = selected
				lib:Save(flag, selected)
			end
		end
	end

	local function UpdateVisuals()
		for _, row in ipairs(rows) do
			local isSel = multi and selected[row.Value] or (selected == row.Value)
			Tween(row.Frame, {BackgroundTransparency = isSel and 0.5 or 0.78}, 0.15)
			Tween(row.Stroke, {Transparency = isSel and 0.85 or 0.96}, 0.15)
			Tween(row.Shadow, {ImageTransparency = isSel and 0.75 or 1}, 0.15)
			Tween(row.Label, {TextColor3 = isSel and Colors.Text or Colors.SubText}, 0.15)
		end
		UpdateSelectedLabel()
	end

	local function BuildRows()
		for _, row in ipairs(rows) do
			row.Frame:Destroy()
		end
		table.clear(rows)
		for i, opt in ipairs(items) do
			local rowHeight = opt.Description and 44 or 32

			local row = New("TextButton", {
				Name = opt.Text,
				BackgroundColor3 = Colors.SurfaceRaised,
				BackgroundTransparency = 0.78,
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, rowHeight),
				LayoutOrder = i,
				Parent = list,
			})

			New("UICorner", {CornerRadius = UDim.new(0, 12), Parent = row})
			local rowStroke = New("UIStroke", {Color = Colors.Stroke, Transparency = 0.96, Thickness = 1, Parent = row})

			local rowShadow = New("ImageLabel", {
				Name = "Shadow",
				BackgroundTransparency = 1,
				Image = SHADOW_IMAGE,
				ImageColor3 = Color3.fromRGB(0, 0, 0),
				ImageTransparency = 1,
				ScaleType = Enum.ScaleType.Slice,
				SliceCenter = Rect.new(10, 10, 118, 118),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, 3),
				Size = UDim2.new(1, 14, 1, 14),
				ZIndex = 0,
				Parent = row,
			})

			New("UIScale", {Scale = 1, Parent = row})
			New("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = row})

			local lbl = New("TextLabel", {
				Name = "Label",
				BackgroundTransparency = 1,
				Text = opt.Text,
				FontFace = TitleFont,
				TextSize = 13,
				TextColor3 = Colors.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = opt.Description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
				Position = opt.Description and UDim2.new(0, 0, 0, 6) or UDim2.new(0, 0, 0, 0),
				Size = UDim2.new(1, 0, opt.Description and 0 or 1, opt.Description and 15 or 0),
				Parent = row,
			})

			if opt.Description then
				New("TextLabel", {
					Name = "Description",
					BackgroundTransparency = 1,
					Text = opt.Description,
					FontFace = DescFont,
					TextSize = 11,
					TextColor3 = Colors.SubText,
					TextTransparency = 0.35,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
					Position = UDim2.new(0, 0, 0, 22),
					Size = UDim2.new(1, 0, 0, 14),
					Parent = row,
				})
			end

			table.insert(rows, {Frame = row, Label = lbl, Stroke = rowStroke, Shadow = rowShadow, Value = opt.Text})

			row.MouseEnter:Connect(function()
				local isSel = multi and selected[opt.Text] or (selected == opt.Text)
				if not isSel then Tween(row, {BackgroundTransparency = 0.65}, 0.2) end
			end)
			row.MouseLeave:Connect(function()
				local isSel = multi and selected[opt.Text] or (selected == opt.Text)
				if not isSel then Tween(row, {BackgroundTransparency = 0.78}, 0.2) end
			end)

			local rowScale = row:FindFirstChildOfClass("UIScale")
			row.MouseButton1Click:Connect(function()
				if rowScale then
					rowScale.Scale = 0.94
					Tween(rowScale, {Scale = 1}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				end
				if multi then
					selected[opt.Text] = not selected[opt.Text]
				else
					selected = opt.Text
				end
				UpdateVisuals()
				SaveFlag()
				callback(multi and selected or selected)
			end)
		end
	end

	BuildRows()
	UpdateVisuals()

	if flag and lib then
		SaveFlag()
	end

	do
		local sv = lib and lib:Load(flag)
		if sv ~= nil then
			if multi and type(sv) == "table" then
				local valid = {}
				for _, o in ipairs(items) do valid[o.Text] = true end
				for _, v in ipairs(sv) do if valid[v] then selected[v] = true end end
			elseif not multi and type(sv) == "string" then
				for _, o in ipairs(items) do if o.Text == sv then selected = sv; break end end
			end
			UpdateVisuals(); SaveFlag()
		end
	end

	if lib then
		lib:OnLanguage(function()
			UpdateSelectedLabel()
		end)
	end

	local function SetExpanded(state)
		expanded = state
		local targetHeight = expanded and (headerHeight + listHeight) or headerHeight
		Tween(holder, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Tween(chevron, {Rotation = expanded and 180 or 0}, 0.28)
	end

	headerBtn.MouseButton1Click:Connect(function()
		SetExpanded(not expanded)
	end)

	headerBtn.MouseEnter:Connect(function()
		if not expanded then Tween(holder, {BackgroundTransparency = 0.65}, 0.2) end
	end)
	headerBtn.MouseLeave:Connect(function()
		if not expanded then Tween(holder, {BackgroundTransparency = 0.78}, 0.2) end
	end)

	local api = {}
	function api:Get()
		return selected
	end
	function api:Set(value, silent)
		if multi then
			selected = {}
			for _, v in ipairs(value) do
				selected[v] = true
			end
		else
			selected = value
		end
		UpdateVisuals()
		SaveFlag()
		if not silent then
			callback(multi and selected or selected)
		end
	end

	function api:Refresh(newRawItems, keepSelection)
		items = NormalizeItems(newRawItems or {})
		listHeight = ComputeListHeight(items)

		if not keepSelection then
			if multi then selected = {} else selected = nil end
		else
			if multi then
				local valid = {}
				for _, opt in ipairs(items) do valid[opt.Text] = true end
				for key in pairs(selected) do
					if not valid[key] then selected[key] = nil end
				end
			else
				local stillValid = false
				for _, opt in ipairs(items) do
					if opt.Text == selected then stillValid = true; break end
				end
				if not stillValid then selected = nil end
			end
		end

		BuildRows()
		UpdateVisuals()

		list.Size = UDim2.new(1, 0, 0, listHeight)
		if expanded then
			Tween(holder, {Size = UDim2.new(1, 0, 0, headerHeight + listHeight)}, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		end

		SaveFlag()
	end

	return api
end

function Window:SelectTab(t)
	if self.CurrentTab == t then return end

	local old = self.CurrentTab

	local function ShowNewContent()
		t.Content.Visible = true
		t.Content.Position = UDim2.new(0, 0, 0, 10)
		Tween(t.Content, {Position = UDim2.new(0, 0, 0, 0)}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	end

	if old then
		old.Selected = false
		Tween(old.Button, {BackgroundTransparency = 1}, 0.2)
		Tween(old.Stroke, {Transparency = 1}, 0.2)
		Tween(old.TitleLabel, {TextColor3 = Colors.SubText}, 0.2)
		Tween(old.Shadow, {ImageTransparency = 1}, 0.2)
		if old.IconImage then
			Tween(old.IconImage, {ImageColor3 = Colors.SubText, ImageTransparency = 0.35}, 0.2)
		end
		local oldContent = old.Content
		Tween(oldContent, {Position = UDim2.new(0, 0, 0, 8)}, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.18, function()
			oldContent.Visible = false
			oldContent.Position = UDim2.new(0, 0, 0, 0)
			ShowNewContent()
		end)
	else
		ShowNewContent()
	end

	t.Selected = true
	Tween(t.Button, {BackgroundTransparency = 0.6, BackgroundColor3 = Colors.SurfaceRaised}, 0.25)
	Tween(t.Stroke, {Transparency = 0.85}, 0.25)
	Tween(t.TitleLabel, {TextColor3 = Colors.Text}, 0.25)
	Tween(t.Shadow, {ImageTransparency = 0.75}, 0.25)
	if t.IconImage then
		Tween(t.IconImage, {ImageColor3 = Colors.Accent, ImageTransparency = 0.05}, 0.25)
	end

	self.CurrentTab = t
end

function Window:Destroy()
	if not self.Frame then return end

	Env.ZeroUILibraryRunning = false
	Env.ZeroUILibraryInstance = nil
	Env.ZeroUILibraryWindow = nil

	for _, notif in ipairs(self.Notifications) do
		if notif.Connection then notif.Connection:Disconnect() end
	end

	if self.NotifyContainer then self.NotifyContainer:Destroy() end
	if self.MobileButton then self.MobileButton:Destroy() end

	local frame = self.Frame
	self.Frame = nil

	Tween(frame, {
		Size = UDim2.new(0, frame.AbsoluteSize.X - 40, 0, frame.AbsoluteSize.Y - 40),
		BackgroundTransparency = 1,
	}, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then Tween(stroke, {Transparency = 1}, 0.3) end

	task.delay(0.32, function()
		frame:Destroy()
	end)
end

return Library
