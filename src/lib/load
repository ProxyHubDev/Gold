end

function Tab:CreateSlider(options)
	options = options or {}
	local target, compact = self:_GetTarget(options.Side)
	target._order = (target._order or 0) + 1
	local lib = target.Library

	local titleRaw = options.Title or "Slider"
	local descriptionRaw = options.Description
	local titleKey = ResolveKey(titleRaw, "Slider")
	local title = lib and lib:Translate(titleRaw) or titleRaw
	local description = descriptionRaw and (lib and lib:Translate(descriptionRaw) or descriptionRaw)
	local min = options.Min or 0
	local max = options.Max or 100
	local decimals = options.Decimals or 0
	local increment = options.Increment or (decimals > 0 and (1 / (10 ^ decimals)) or 1)
	local suffix = options.Suffix or ""
	local default = options.Default or min
	local callback = options.Callback or function() end

	local flag = options.Flag or ("_auto_" .. tostring(target._tabTitle or "Global") .. "_Slider_" .. titleKey)

	local function Round(value)
		local stepped = min + math.floor(((value - min) / increment) + 0.5) * increment
		stepped = math.clamp(stepped, min, max)
		local mult = 10 ^ decimals
		stepped = math.floor(stepped * mult + 0.5) / mult
		return stepped
	end

	local function Format(value)
		if decimals > 0 then
			return string.format("%." .. decimals .. "f", value) .. suffix
		end
		return tostring(math.floor(value + 0.5)) .. suffix
	end

	local rowHeight = description and (compact and 60 or 78) or (compact and 38 or 52)
	local padV = compact and 8 or 12
	local trackWidth = compact and 80 or 108
	local valueWidth = compact and 38 or 52
	local rightReserve = compact and 134 or 192

	local holder = New("Frame", {
		Name = titleKey,
		BackgroundColor3 = Colors.SurfaceRaised,
		BackgroundTransparency = 0.78,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, rowHeight),
		LayoutOrder = target._order,
		Parent = target.Content,
	}, {
		New("UICorner", {CornerRadius = UDim.new(0, 12)}),
		New("UIStroke", {Color = Colors.Stroke, Transparency = 0.96, Thickness = 1}),
		New("UIPadding", {
			PaddingLeft = UDim.new(0, compact and 12 or 18),
			PaddingRight = UDim.new(0, compact and 12 or 18),
			PaddingTop = UDim.new(0, padV),
			PaddingBottom = UDim.new(0, padV),
		}),
	})

	local titleLabel = New("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Text = title,
		FontFace = TitleFont,
		TextSize = compact and 13 or 16,
		TextColor3 = Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -rightReserve, description and 0 or 1, description and (compact and 16 or 20) or 0),
		Parent = holder,
	})
	if lib then lib:Track(titleLabel, "Text", titleRaw) end

	if description then
		local descLabel = New("TextLabel", {
			Name = "Description",
			BackgroundTransparency = 1,
			Text = description,
			FontFace = DescFont,
			TextSize = compact and 11 or 14,
			TextColor3 = Colors.SubText,
			TextTransparency = 0.08,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, 0, 0, compact and 18 or 22),
			Size = UDim2.new(1, -rightReserve, 0, compact and 26 or 32),
			Parent = holder,
		})
		if lib then lib:Track(descLabel, "Text", descriptionRaw) end
	end

	local rightGroup = New("Frame", {
		Name = "RightGroup",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0.5, -10),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 20),
		Parent = holder,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, compact and 6 or 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local track = New("Frame", {
		Name = "Track",
		BackgroundTransparency = 1,
		Active = true,
		Size = UDim2.new(0, trackWidth, 0, 20),
		LayoutOrder = 1,
		Parent = rightGroup,
	})

	local valueBox = New("TextBox", {
		Name = "Value",
		BackgroundTransparency = 1,
		Text = Format(default),
		FontFace = TitleFont,
		TextSize = compact and 12 or 15,
		TextColor3 = Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(0, valueWidth, 0, 20),
		LayoutOrder = 2,
		Parent = rightGroup,
	})

	local bar = New("Frame", {
		Name = "Bar",
		BackgroundColor3 = Colors.SurfaceHover,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 8),
		Parent = track,
	}, {
		New("UICorner", {CornerRadius = UDim.new(1, 0)}),
		New("UIStroke", {Color = Colors.Stroke, Transparency = 0.92, Thickness = 1}),
	})

	local fill = New("Frame", {
		Name = "Fill",
		BackgroundColor3 = Colors.Accent,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 0, 1, 0),
		Parent = bar,
	}, {
		New("UICorner", {CornerRadius = UDim.new(1, 0)}),
	})

	local knob = New("Frame", {
		Name = "Knob",
		BackgroundColor3 = Colors.Text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16),
		ZIndex = 2,
		Parent = track,
	}, {
		New("UICorner", {CornerRadius = UDim.new(1, 0)}),
		New("UIStroke", {Color = Colors.Stroke, Transparency = 0.8, Thickness = 1}),
	})

	local api = {}
	api.Value = Round(default)

	if flag and lib then
		lib.Flags[flag] = api.Value
	end

	local function Render(instant)
		local duration = instant and 0 or 0.12
		local alpha = (max > min) and ((api.Value - min) / (max - min)) or 0
		alpha = math.clamp(alpha, 0, 1)
		Tween(fill, {Size = UDim2.new(alpha, 0, 1, 0)}, duration, Enum.EasingStyle.Sine)
		Tween(knob, {Position = UDim2.new(alpha, 0, 0.5, 0)}, duration, Enum.EasingStyle.Sine)
		if not valueBox:IsFocused() then
			valueBox.Text = Format(api.Value)
		end
	end

	function api:Set(value, silent)
		api.Value = Round(value)
		Render(false)
		if flag and lib then
			lib.Flags[flag] = api.Value
			lib:Save(flag, api.Value)
		end
		if not silent then
			callback(api.Value)
		end
	end

	valueBox.Focused:Connect(function()
		valueBox.Text = tostring(api.Value)
	end)

	valueBox.FocusLost:Connect(function()
		local num = tonumber(valueBox.Text)
		if num then
			api:Set(num)
		else
			valueBox.Text = Format(api.Value)
		end
	end)

	local dragging = false

	local function UpdateFromInput(xPos)
		local trackAbsPos = bar.AbsolutePosition.X
		local trackAbsSize = bar.AbsoluteSize.X
		if trackAbsSize <= 0 then return end
		local alpha = (xPos - trackAbsPos) / trackAbsSize
		alpha = math.clamp(alpha, 0, 1)
		local value = min + alpha * (max - min)
		api:Set(value)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			Tween(knob, {Size = UDim2.new(0, 18, 0, 18)}, 0.12)
			UpdateFromInput(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateFromInput(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			Tween(knob, {Size = UDim2.new(0, 16, 0, 16)}, 0.12)
		end
	end)

	Render(true)

	do local sv = lib and lib:Load(flag); if sv ~= nil then api:Set(sv, true) end end

	return api
end

function Tab:CreateDropdown(options)
	options = options or {}
	local target, compact = self:_GetTarget(options.Side)
	target._order = (target._order or 0) + 1
	local lib = target.Library

	local titleRaw = options.Title or "Dropdown"
	local descriptionRaw = options.Description
	local titleKey = ResolveKey(titleRaw, "Dropdown")
	local title = lib and lib:Translate(titleRaw) or titleRaw
	local description = descriptionRaw and (lib and lib:Translate(descriptionRaw) or descriptionRaw)
	local rawItems = options.Options or {}
	local multi = options.Multi or false
	local default = options.Default
	local callback = options.Callback or function() end
	local placeholderRaw = options.Placeholder or {PT = "Nenhuma opção selecionada", EN = "No option selected"}

	local flag = options.Flag or ("_auto_" .. tostring(target._tabTitle or "Global") .. "_Dropdown_" .. titleKey)

	local itemGap = 8
	local listPadTop, listPadBottom = 8, 10

	local function NormalizeItems(raw)
		local list = {}
		for _, opt in ipairs(raw) do
			if type(opt) == "table" then
				table.insert(list, {Text = opt.Text or opt.Title or "Option", Description = opt.Description})
			else
				table.insert(list, {Text = tostring(opt), Description = nil})
			end
		end
		return list
	end

	local function ComputeListHeight(list)
		local height = listPadTop + listPadBottom
		for i, opt in ipairs(list) do
			height += (opt.Description and 44 or 32)
			if i > 1 then height += itemGap end
		end
		return height
	end

	local items = NormalizeItems(rawItems)
	local headerHeight = description and (compact and 60 or 78) or (compact and 38 or 52)
	local listHeight = ComputeListHeight(items)
	local expanded = false

	local holder = New("Frame", {
		Name = titleKey,
		BackgroundColor3 = Colors.SurfaceRaised,
		BackgroundTransparency = 0.78,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, headerHeight),
