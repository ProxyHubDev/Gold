local function ResolveKey(value, fallback)
	if type(value) == "table" then
		return value.PT or value.EN or fallback
	end
	return value or fallback
end

local function CapitalizeWord(word)
	if word == "" then
		return word
	end
	return word:sub(1, 1):upper() .. word:sub(2)
end

local ReverseDictionary = {}
for ptWord, enWord in pairs(AutoDictionary) do
	local enLower = tostring(enWord):lower()
	if not ReverseDictionary[enLower] then
		ReverseDictionary[enLower] = ptWord
	end
end

local function GetDictionaryFor(language)
	if language == "EN" then
		return AutoDictionary
	end
	return ReverseDictionary
end

local function BuildPhraseIndex(dict)
	local index = {}
	for key, value in pairs(dict) do
		local words = {}
		for w in tostring(key):gmatch("[%a\128-\255]+") do
			table.insert(words, w)
		end
		if #words > 1 then
			local firstWord = words[1]:lower()
			index[firstWord] = index[firstWord] or {}
			table.insert(index[firstWord], {Words = words, Value = value})
		end
	end
	for _, list in pairs(index) do
		table.sort(list, function(a, b) return #a.Words > #b.Words end)
	end
	return index
end

local PhraseIndexEN = BuildPhraseIndex(AutoDictionary)
local PhraseIndexPT = BuildPhraseIndex(ReverseDictionary)

local function GetPhraseIndexFor(language)
	if language == "EN" then
		return PhraseIndexEN
	end
	return PhraseIndexPT
end

local function AutoTranslateText(text, language)
	if type(text) ~= "string" or text == "" then
		return text
	end

	local dict = GetDictionaryFor(language)
	local lower = text:lower()
	local direct = dict[lower]
	if direct then
		if text:sub(1, 1):match("%u") then
			return CapitalizeWord(direct)
		end
		return direct
	end

	local phraseIndex = GetPhraseIndexFor(language)

	local tokens = {}
	for word, sep in text:gmatch("([%a\128-\255]*)([^%a\128-\255]*)") do
		if word ~= "" or sep ~= "" then
			table.insert(tokens, {Word = word, Sep = sep})
		end
	end

	local parts = {}
	local i = 1
	while i <= #tokens do
		local tok = tokens[i]
		if tok.Word == "" then
			table.insert(parts, tok.Sep)
			i += 1
		else
			local wordLower = tok.Word:lower()
			local candidates = phraseIndex[wordLower]
			local matched = false

			if candidates then
				for _, candidate in ipairs(candidates) do
					local span = #candidate.Words
					if i + span - 1 <= #tokens then
						local ok = true
						for k = 1, span do
							if tokens[i + k - 1].Word:lower() ~= candidate.Words[k]:lower() then
								ok = false
								break
							end
						end
						if ok then
							local translated = candidate.Value
							if tok.Word:sub(1, 1):match("%u") then
								translated = CapitalizeWord(translated)
							end
							table.insert(parts, translated .. tokens[i + span - 1].Sep)
							i += span
							matched = true
							break
						end
					end
				end
			end

			if not matched then
				local translated = dict[wordLower]
				if translated then
					if tok.Word:sub(1, 1):match("%u") then
						translated = CapitalizeWord(translated)
					end
					table.insert(parts, translated .. tok.Sep)
				else
					table.insert(parts, tok.Word .. tok.Sep)
				end
				i += 1
			end
		end
	end

	local result = table.concat(parts)
	if result == "" then
		return text
	end
	return result
end

function Library.new()
	local self = setmetatable({}, Library)

	if Env.ZeroUILibraryRunning and Env.ZeroUILibraryInstance then
		self.IsDuplicate = true
		self.MainInstance = Env.ZeroUILibraryInstance
		return self
	end

	self.Flags = {}
	self.Registry = {}
	self.LanguageListeners = {}
	_G.ZeroSave = _G.ZeroSave or {}
	self.Language = "PT"
	self.Dictionary = AutoDictionary

	self.ScreenGui = New("ScreenGui", {
		Name = "ZeroUILibrary",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})

	local parented = pcall(function()
		self.ScreenGui.Parent = CoreGui
	end)
	if not parented then
		self.ScreenGui.Parent = GetPlayerGui()
	end

	return self
end

function Library:Translate(value)
	if type(value) == "table" then
		return value[self.Language] or value.PT or value.EN or ""
	end

	if type(value) ~= "string" then
		return value
	end

	return AutoTranslateText(value, self.Language)
end

function Library:Track(inst, prop, data)
	if data == nil then
		return
	end
	table.insert(self.Registry, {Instance = inst, Property = prop, Data = data})
end

function Library:OnLanguage(callback)
	table.insert(self.LanguageListeners, callback)
end

function Library:SetLanguage(lang)
	self.Language = lang
	for _, entry in ipairs(self.Registry) do
		if entry.Instance and entry.Instance.Parent then
			entry.Instance[entry.Property] = self:Translate(entry.Data)
		end
	end
	for _, cb in ipairs(self.LanguageListeners) do
		cb(lang)
	end
end

function Library:GetLanguage()
	return self.Language
end

function Library:Save(flag, value)
	if not flag then return end
	_G.ZeroSave = _G.ZeroSave or {}
	_G.ZeroSave[flag] = value
end

function Library:Load(flag)
	if not flag then return nil end
	return _G.ZeroSave and _G.ZeroSave[flag]
end

